# PrAgents — environment variables
# Copy to ~/.pragents/.env and fill in your keys.

# API keys for model providers (uncomment the ones you use)
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#GOOGLE_API_KEY=...
#DEEPSEEK_API_KEY=...

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# API token for remote clients. If left unset, the server generates a 32-byte
# hex token on first boot and appends it here automatically. Localhost requests
# bypass auth, so local dev does not require setting this manually.
#PRAGENTS_API_TOKEN=

# Skills directory (default: ~/.pragents/skills/)
#PRAGENTS_SKILLS_DIR=~/.pragents/skills

# Allow WebSocket clients to authenticate via ?token= query parameter.
# Disabled by default: query strings leak into logs and proxy history.
# Prefer Authorization: Bearer (non-browser clients) or the WS ticket flow.
#PRAGENTS_ALLOW_WS_QUERY_TOKEN=1
